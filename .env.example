# Supabase. Never put a service role key in browser-visible variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Used only by the authenticated server-side cron sync; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Restrict access to your Google account.
OWNER_EMAIL=

# Server-side provider secrets; never expose these to the browser.
GROQ_API_KEY=
GROQ_MODEL=
BUFFER_API_KEY_PERSONAL=
BUFFER_API_KEY_BARCELONA_JUG=
BUFFER_API_KEY_SOFTWARE_CRAFTERS_BARCELONA=
# Used to authenticate the server-side event sync endpoint.
CRON_SECRET=
# Reserved for a possible Jev decision service; the application does not call Jev today.
JEV_API_KEY=
